    {
      "id": "larger_finite_ceiling_below_complete_information",
      "mean": 3.2,
      "count_ceiling": 4,
      "expected_fisher": 0.25731350678296383,
      "tolerance": 2e-12
    },
    {
      "id": "uncensored_boundary",
      "mean": 2.0,
      "count_ceiling": null,
      "expected_fisher": 0.5,
      "tolerance": 1e-14
    }
  ],
  "fisher_interval_cases": [
    {
      "id": "positive_smooth_finite_ceiling_compact_interval",
      "mean_interval": [0.4, 4.0],
      "count_ceiling": 3,
      "grid_points": 41,
      "expect_strictly_positive": true,
      "tolerance": 1e-12
    },
    {
      "id": "zero_ceiling_compact_interval_is_null",
      "mean_interval": [0.4, 4.0],
      "count_ceiling": 0,
      "grid_points": 17,
      "expect_strictly_positive": false,
      "tolerance": 1e-12
    },
    {
      "id": "uncensored_compact_interval",
      "mean_interval": [0.4, 4.0],
      "count_ceiling": null,
      "grid_points": 17,
      "expect_strictly_positive": true,
      "tolerance": 1e-12
